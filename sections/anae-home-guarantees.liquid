{%- style -%}
  #shopify-section-{{ section.id }} .anae-gar {
    --anae-accent: #D4537E; --anae-accent-2: #E8915B; --anae-ink: #3A2A22;
    --anae-cream: #FBF3E9; --anae-beige: #F0DCC4;
    background: var(--anae-beige); color: var(--anae-ink);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .anae-gar__wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  #shopify-section-{{ section.id }} .anae-gar__head { text-align: center; max-width: 60ch; margin: 0 auto 44px; }
  #shopify-section-{{ section.id }} .anae-gar__eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: 1.2rem; font-weight: 700; color: var(--anae-accent); margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .anae-gar__title { font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: clamp(2.6rem, 4vw, 4rem); line-height: 1.1; margin: 0; font-weight: 600; }
  #shopify-section-{{ section.id }} .anae-gar__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; }
  #shopify-section-{{ section.id }} .anae-gar__card {
    background: transparent; border-radius: 18px; padding: 20px 16px; text-align: center;
    display: flex; flex-direction: column; align-items: center;
  }
  #shopify-section-{{ section.id }} .anae-gar__ic {
    width: 58px; height: 58px; border-radius: 16px; margin: 0 0 16px;
    background: linear-gradient(54deg, var(--anae-accent-2) 14%, var(--anae-accent) 85%);
    display: flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ section.id }} .anae-gar__ic svg { width: 28px; height: 28px; fill: #fff; }
  #shopify-section-{{ section.id }} .anae-gar__card h3 { font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: 1.9rem; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .anae-gar__card p { font-size: 1.4rem; line-height: 1.5; opacity: .82; margin: 0; }
{%- endstyle -%}

<section class="anae-gar" aria-label="Nos garanties">
  <div class="anae-gar__wrap">
    <div class="anae-gar__head">
      {%- if section.settings.eyebrow != blank -%}<p class="anae-gar__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="anae-gar__title">{{ section.settings.title }}</h2>{%- endif -%}
    </div>
    <div class="anae-gar__grid">
      {%- for block in section.blocks -%}
        <div class="anae-gar__card" {{ block.shopify_attributes }}>
          <span class="anae-gar__ic">{% render 'anae-icons', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Anaé · Garanties",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Commande en confiance" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos garanties" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge haut", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge bas", "default": 64 }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Garantie",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "shield",
          "options": [
            { "value": "shield", "label": "Garantie / Bouclier" }, { "value": "lock", "label": "Paiement sécurisé" },
            { "value": "truck", "label": "Livraison" }, { "value": "headset", "label": "Support" },
            { "value": "medal", "label": "Qualité" }, { "value": "heart", "label": "Satisfaction" },
            { "value": "leaf", "label": "Naturel" }, { "value": "refresh", "label": "Retours" }
          ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Satisfait ou remboursé" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "60 jours pour te faire ton avis, sans risque." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anaé · Garanties",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "heart", "title": "Satisfait ou remboursé", "text": "60 jours pour tester Anaé sans risque, même stick entamé." } },
        { "type": "guarantee", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "Transactions chiffrées et 100 % protégées." } },
        { "type": "guarantee", "settings": { "icon": "truck", "title": "Livraison rapide", "text": "Expédition sous 24-48 h en France & au Québec." } },
        { "type": "guarantee", "settings": { "icon": "headset", "title": "Support client", "text": "Une question ? On te répond sous 24 h ouvrées." } },
        { "type": "guarantee", "settings": { "icon": "medal", "title": "Garantie qualité", "text": "Une formule courte et lisible, des actifs sélectionnés." } }
      ]
    }
  ]
}
{% endschema %}
