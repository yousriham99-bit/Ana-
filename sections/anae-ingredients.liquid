{%- style -%}
  #shopify-section-{{ section.id }} .anae-ing {
    --anae-accent: #D4537E;
    --anae-accent-2: #E8915B;
    --anae-ink: #3A2A22;
    --anae-cream: #FBF3E9;
    --anae-beige: #F0DCC4;
    background: var(--anae-cream);
    color: var(--anae-ink);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .anae-ing__wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  #shopify-section-{{ section.id }} .anae-ing__eyebrow {
    text-transform: uppercase; letter-spacing: .18em; font-size: 1.2rem; font-weight: 700;
    color: var(--anae-accent); text-align: center; margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .anae-ing__title {
    font-family: var(--font-heading-family, 'Fraunces', Georgia, serif);
    font-size: clamp(2.6rem, 4vw, 4rem); line-height: 1.1; text-align: center;
    margin: 0 auto 14px; max-width: 20ch;
  }
  #shopify-section-{{ section.id }} .anae-ing__intro {
    text-align: center; max-width: 60ch; margin: 0 auto 44px; font-size: 1.7rem; opacity: .85;
  }
  #shopify-section-{{ section.id }} .anae-ing__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 24px;
  }
  #shopify-section-{{ section.id }} .anae-ing__card {
    background: #fff; border: 1px solid rgba(58,42,34,.08); border-radius: 18px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(58,42,34,.06); display: flex; flex-direction: column;
  }
  #shopify-section-{{ section.id }} .anae-ing__media {
    aspect-ratio: 4/3; background: var(--anae-beige); position: relative;
  }
  #shopify-section-{{ section.id }} .anae-ing__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .anae-imgph {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(58,42,34,.4);
    border: 2px dashed rgba(58,42,34,.18);
  }
  #shopify-section-{{ section.id }} .anae-ing__body { padding: 22px 22px 26px; }
  #shopify-section-{{ section.id }} .anae-ing__name {
    font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: 2rem; margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .anae-ing__tag {
    display: inline-block; font-size: 1.1rem; font-weight: 700; color: var(--anae-accent);
    background: rgba(212,83,126,.1); padding: 3px 10px; border-radius: 999px; margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .anae-ing__text { margin: 0; font-size: 1.45rem; line-height: 1.55; opacity: .9; }
{%- endstyle -%}

<div class="anae-ing">
  <div class="anae-ing__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="anae-ing__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="anae-ing__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="anae-ing__intro">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="anae-ing__grid">
      {%- for block in section.blocks -%}
        <div class="anae-ing__card" {{ block.shopify_attributes }}>
          <div class="anae-ing__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="600" height="450">
            {%- else -%}
              <span class="anae-imgph">Image à venir</span>
            {%- endif -%}
          </div>
          <div class="anae-ing__body">
            {%- if block.settings.tag != blank -%}<span class="anae-ing__tag">{{ block.settings.tag }}</span>{%- endif -%}
            <h3 class="anae-ing__name">{{ block.settings.name }}</h3>
            <p class="anae-ing__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anaé · Ingrédients",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La formule" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une formule courte. Des actifs qui comptent." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Pas de liste à rallonge : chaque ingrédient d'Anaé a une raison d'être. Voici ce qui compose ton stick.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge haut", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge bas", "default": 64 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrédient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Étiquette", "default": "Actif clé" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Berbérine" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Un actif d'origine végétale au cœur de la formule, choisi pour accompagner ton énergie au quotidien." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anaé · Ingrédients",
      "blocks": [
        { "type": "ingredient", "settings": { "tag": "Actif clé", "name": "Berbérine", "text": "L'actif signature d'Anaé, extrait de plantes. Il structure la formule et soutient ton énergie de fond." } },
        { "type": "ingredient", "settings": { "tag": "Énergie", "name": "Yerba Maté", "text": "La plante des gauchos d'Amérique du Sud, riche en caféine naturelle, pour un boost franc sans la nervosité du café." } },
        { "type": "ingredient", "settings": { "tag": "Vitalité", "name": "Vitamines B", "text": "Un coup de pouce au métabolisme énergétique, pour transformer ce que tu manges en énergie utilisable." } },
        { "type": "ingredient", "settings": { "tag": "Plaisir", "name": "Arôme fraise naturel", "text": "Une saveur fraîche et gourmande qui donne envie de recommencer. Zéro arrière-goût poudreux." } }
      ]
    }
  ]
}
{% endschema %}
