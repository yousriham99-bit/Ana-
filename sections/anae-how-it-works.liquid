{%- style -%}
  #shopify-section-{{ section.id }} .anae-how {
    --anae-accent: #D4537E; --anae-accent-2: #E8915B; --anae-ink: #3A2A22;
    --anae-cream: #FBF3E9; --anae-beige: #F0DCC4;
    background: #ffffff;
    color: var(--anae-ink);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .anae-how__wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  #shopify-section-{{ section.id }} .anae-how__eyebrow {
    text-transform: uppercase; letter-spacing: .18em; font-size: 1.2rem; font-weight: 700;
    color: var(--anae-accent); text-align: center; margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .anae-how__title {
    font-family: var(--font-heading-family, 'Fraunces', Georgia, serif);
    font-size: clamp(2.6rem, 4vw, 4rem); line-height: 1.1; text-align: center; margin: 0 auto 48px; max-width: 18ch;
  }
  #shopify-section-{{ section.id }} .anae-how__steps {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 30px; counter-reset: step;
  }
  #shopify-section-{{ section.id }} .anae-how__step { text-align: center; position: relative; }
  #shopify-section-{{ section.id }} .anae-how__num {
    counter-increment: step; width: 64px; height: 64px; border-radius: 50%;
    background: linear-gradient(54deg, var(--anae-accent-2) 14%, var(--anae-accent) 85%);
    color: #fff; font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: 2.6rem;
    display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; box-shadow: 0 8px 20px rgba(212,83,126,.3);
  }
  #shopify-section-{{ section.id }} .anae-how__num::before { content: counter(step); }
  #shopify-section-{{ section.id }} .anae-how__media {
    aspect-ratio: 1/1; max-width: 200px; margin: 0 auto 18px; border-radius: 18px; overflow: hidden;
    background: var(--anae-beige); position: relative;
  }
  #shopify-section-{{ section.id }} .anae-how__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .anae-imgph {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(58,42,34,.4);
    border: 2px dashed rgba(58,42,34,.18); text-align: center; padding: 6px;
  }
  #shopify-section-{{ section.id }} .anae-how__step h3 {
    font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: 2rem; margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .anae-how__step p { margin: 0; font-size: 1.5rem; line-height: 1.55; opacity: .9; }
  #shopify-section-{{ section.id }} .anae-how__note {
    text-align: center; margin: 44px auto 0; max-width: 62ch; font-size: 1.45rem; opacity: .8;
    background: rgba(212,83,126,.06); border-left: 3px solid var(--anae-accent); border-radius: 8px; padding: 16px 22px;
  }
{%- endstyle -%}

<div class="anae-how">
  <div class="anae-how__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="anae-how__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="anae-how__title">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="anae-how__steps">
      {%- for block in section.blocks -%}
        <div class="anae-how__step" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="anae-how__media"><img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="400" height="400"></div>
          {%- else -%}
            <div class="anae-how__num"></div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<div class="anae-how__note">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Anaé · Comment ça marche",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le rituel" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ton énergie en 3 gestes" },
    { "type": "richtext", "id": "note", "label": "Note bas de section", "default": "<p>Un geste de 10 secondes, le matin ou en début d'aprèm. Aucune préparation, aucune contrainte — juste toi et ton verre.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge haut", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge bas", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optionnel)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Verse ton stick" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Dans un grand verre d'eau fraîche." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anaé · Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Verse", "text": "Un stick Anaé dans un grand verre d'eau fraîche, où que tu sois." } },
        { "type": "step", "settings": { "title": "Mélange", "text": "10 secondes suffisent. La poudre se dissout, la couleur fraise apparaît." } },
        { "type": "step", "settings": { "title": "Ressens", "text": "Une énergie nette qui monte en douceur — sans pic, sans chute, sans nervosité." } }
      ]
    }
  ]
}
{% endschema %}
