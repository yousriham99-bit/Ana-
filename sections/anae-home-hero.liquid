{%- liquid
  assign star = '<svg viewBox="0 0 576 512" aria-hidden="true"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>'
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .anae-hero {
    --anae-accent: #D4537E; --anae-accent-2: #E8915B; --anae-ink: #3A2A22;
    --anae-cream: #FBF3E9; --anae-beige: #F0DCC4;
    background: linear-gradient(180deg, var(--anae-cream) 0%, #ffffff 100%);
    color: var(--anae-ink);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .anae-hero__wrap {
    max-width: 1220px; margin: 0 auto; padding: 0 20px;
    display: grid; grid-template-columns: 1.05fr .95fr; gap: 54px; align-items: center;
  }
  #shopify-section-{{ section.id }} .anae-hero__eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    text-transform: uppercase; letter-spacing: .16em; font-size: 1.2rem; font-weight: 700;
    color: var(--anae-accent); background: rgba(212,83,126,.09);
    padding: 7px 14px; border-radius: 100px; margin: 0 0 20px;
  }
  #shopify-section-{{ section.id }} .anae-hero__eyebrow svg { width: 13px; height: 13px; fill: currentColor; flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .anae-hero__title {
    font-family: var(--font-heading-family, 'Fraunces', Georgia, serif);
    font-size: clamp(3.2rem, 5vw, 5.4rem); line-height: 1.05; margin: 0 0 18px; font-weight: 600;
  }
  #shopify-section-{{ section.id }} .anae-hero__title em { color: var(--anae-accent); font-style: normal; }
  #shopify-section-{{ section.id }} .anae-hero__sub { font-size: 1.75rem; line-height: 1.55; opacity: .85; margin: 0 0 26px; max-width: 46ch; }
  #shopify-section-{{ section.id }} .anae-hero__rating { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 26px; text-decoration: none; color: inherit; }
  #shopify-section-{{ section.id }} .anae-hero__rating .anae-stars { display: inline-flex; gap: 2px; }
  #shopify-section-{{ section.id }} .anae-hero__rating .anae-stars svg { width: 18px; height: 18px; fill: var(--anae-accent); }
  #shopify-section-{{ section.id }} .anae-hero__rating b { font-size: 1.45rem; }
  #shopify-section-{{ section.id }} .anae-hero__rating span { font-size: 1.4rem; opacity: .7; text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ section.id }} .anae-hero__cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: linear-gradient(54deg, var(--anae-accent-2) 14%, var(--anae-accent) 85%);
    color: #fff; font-weight: 700; font-size: 1.7rem; letter-spacing: .01em;
    padding: 18px 40px; border-radius: 100px; text-decoration: none;
    box-shadow: 0 14px 30px rgba(212,83,126,.32); transition: transform .15s ease, box-shadow .15s ease;
  }
  #shopify-section-{{ section.id }} .anae-hero__cta:hover { transform: translateY(-2px); box-shadow: 0 18px 38px rgba(212,83,126,.4); }
  #shopify-section-{{ section.id }} .anae-hero__cta svg { width: 18px; height: 18px; fill: #fff; flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .anae-hero__reassure { margin: 16px 0 0; font-size: 1.35rem; opacity: .7; }
  #shopify-section-{{ section.id }} .anae-hero__media { position: relative; }
  #shopify-section-{{ section.id }} .anae-hero__media img {
    width: 100%; height: auto; border-radius: 26px; display: block;
    box-shadow: 0 30px 70px rgba(58,42,34,.18);
  }
  #shopify-section-{{ section.id }} .anae-ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    aspect-ratio: 4 / 5; border-radius: 26px; text-align: center;
    background: linear-gradient(135deg, var(--anae-beige), #fff);
    border: 1px dashed rgba(212,83,126,.4); color: var(--anae-accent);
  }
  #shopify-section-{{ section.id }} .anae-ph svg { width: 46px; height: 46px; fill: currentColor; opacity: .55; }
  #shopify-section-{{ section.id }} .anae-ph span { font-size: 1.35rem; font-weight: 700; opacity: .7; }
  #shopify-section-{{ section.id }} .anae-hero__badge {
    position: absolute; left: -14px; bottom: 26px;
    background: #fff; border-radius: 16px; padding: 12px 18px; display: flex; align-items: center; gap: 12px;
    box-shadow: 0 16px 40px rgba(58,42,34,.16);
  }
  #shopify-section-{{ section.id }} .anae-hero__badge .anae-hero__badge-ic {
    width: 40px; height: 40px; border-radius: 12px; flex: 0 0 auto;
    background: linear-gradient(54deg, var(--anae-accent-2) 14%, var(--anae-accent) 85%);
    display: flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ section.id }} .anae-hero__badge svg { width: 22px; height: 22px; fill: #fff; }
  #shopify-section-{{ section.id }} .anae-hero__badge b { font-size: 1.5rem; display: block; line-height: 1.1; }
  #shopify-section-{{ section.id }} .anae-hero__badge small { font-size: 1.2rem; opacity: .7; }
  #shopify-section-{{ section.id }} .anae-hero__adv {
    margin-top: 46px; border-top: 1px solid rgba(58,42,34,.12); padding-top: 26px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 18px;
  }
  #shopify-section-{{ section.id }} .anae-hero__adv-item { display: flex; align-items: center; gap: 12px; }
  #shopify-section-{{ section.id }} .anae-hero__adv-ic {
    width: 42px; height: 42px; border-radius: 12px; flex: 0 0 auto;
    display: flex; align-items: center; justify-content: center;
    background: rgba(212,83,126,.1); color: var(--anae-accent);
  }
  #shopify-section-{{ section.id }} .anae-hero__adv-ic svg { width: 22px; height: 22px; fill: currentColor; }
  #shopify-section-{{ section.id }} .anae-hero__adv-item b { font-size: 1.4rem; line-height: 1.2; }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .anae-hero__wrap { grid-template-columns: 1fr; gap: 34px; }
    #shopify-section-{{ section.id }} .anae-hero__media { order: -1; max-width: 460px; margin: 0 auto; width: 100%; }
    #shopify-section-{{ section.id }} .anae-hero__adv { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<section class="anae-hero" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="anae-hero__wrap">
    <div class="anae-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="anae-hero__eyebrow">{% render 'anae-icons', icon: 'sparkle' %}{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="anae-hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<div class="anae-hero__sub">{{ section.settings.subheading }}</div>{%- endif -%}

      {%- if section.settings.show_rating -%}
        <a class="anae-hero__rating" href="{{ section.settings.reviews_anchor }}">
          <span class="anae-stars">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>
          <b>{{ section.settings.rating_value }}</b>
          <span>{{ section.settings.review_count }} avis vérifiés</span>
        </a>
      {%- endif -%}

      <div>
        <a class="anae-hero__cta" href="{{ section.settings.cta_url }}">
          {% render 'anae-icons', icon: 'bolt' %}{{ section.settings.cta_label }}
        </a>
      </div>
      {%- if section.settings.reassurance != blank -%}<p class="anae-hero__reassure">{{ section.settings.reassurance }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="anae-hero__adv">
          {%- for block in section.blocks -%}
            <div class="anae-hero__adv-item" {{ block.shopify_attributes }}>
              <span class="anae-hero__adv-ic">{% render 'anae-icons', icon: block.settings.icon %}</span>
              <b>{{ block.settings.title }}</b>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="anae-hero__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}"
             srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
             sizes="(max-width: 900px) 90vw, 46vw"
             alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
             width="900" height="1125" loading="eager" fetchpriority="high">
      {%- else -%}
        <div class="anae-ph">{% render 'anae-icons', icon: 'drop' %}<span>Image produit à venir</span></div>
      {%- endif -%}
      {%- if section.settings.badge_title != blank -%}
        <div class="anae-hero__badge">
          <span class="anae-hero__badge-ic">{% render 'anae-icons', icon: section.settings.badge_icon %}</span>
          <div><b>{{ section.settings.badge_title }}</b><small>{{ section.settings.badge_text }}</small></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Anaé · Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Énergie naturelle · saveur fraise" },
    { "type": "text", "id": "heading", "label": "Titre (H1)", "default": "Ton énergie nette, dans un simple <em>stick</em>" },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre", "default": "<p>Berbérine + yerba maté dans un verre d'eau. Un boost franc qui tient la journée, sans la nervosité ni la chute du café de 16h.</p>" },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Commander maintenant" },
    { "type": "url", "id": "cta_url", "label": "Bouton — lien" },
    { "type": "text", "id": "reassurance", "label": "Réassurance sous le bouton", "default": "Satisfait ou remboursé 60 jours · Livraison France & Québec" },
    { "type": "header", "content": "Note & avis" },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher la note", "default": true },
    { "type": "text", "id": "rating_value", "label": "Note affichée", "default": "4,9/5" },
    { "type": "text", "id": "review_count", "label": "Nombre d'avis", "default": "127" },
    { "type": "text", "id": "reviews_anchor", "label": "Ancre section avis", "default": "#avis" },
    { "type": "header", "content": "Image produit" },
    { "type": "image_picker", "id": "image", "label": "Image (placeholder si vide)" },
    { "type": "header", "content": "Badge flottant (optionnel)" },
    { "type": "text", "id": "badge_title", "label": "Badge — titre", "default": "10 secondes" },
    { "type": "text", "id": "badge_text", "label": "Badge — texte", "default": "Un stick, un verre d'eau" },
    { "type": "select", "id": "badge_icon", "label": "Badge — icône", "default": "timer",
      "options": [
        { "value": "timer", "label": "Chrono" }, { "value": "bolt", "label": "Éclair" },
        { "value": "leaf", "label": "Feuille" }, { "value": "drop", "label": "Goutte" },
        { "value": "heart", "label": "Cœur" }
      ] },
    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge haut", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Marge bas", "default": 72 }
  ],
  "blocks": [
    {
      "type": "advantage",
      "name": "Avantage",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "truck",
          "options": [
            { "value": "truck", "label": "Livraison" }, { "value": "lock", "label": "Paiement sécurisé" },
            { "value": "shield", "label": "Garantie" }, { "value": "heart", "label": "Satisfaction" },
            { "value": "leaf", "label": "Naturel" }, { "value": "bolt", "label": "Énergie" },
            { "value": "headset", "label": "Support" }, { "value": "timer", "label": "Rapidité" }
          ] },
        { "type": "text", "id": "title", "label": "Texte", "default": "Livraison rapide" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anaé · Hero",
      "blocks": [
        { "type": "advantage", "settings": { "icon": "truck", "title": "Livraison rapide" } },
        { "type": "advantage", "settings": { "icon": "lock", "title": "Paiement sécurisé" } },
        { "type": "advantage", "settings": { "icon": "shield", "title": "Satisfait ou remboursé" } },
        { "type": "advantage", "settings": { "icon": "leaf", "title": "Actifs naturels" } }
      ]
    }
  ]
}
{% endschema %}
