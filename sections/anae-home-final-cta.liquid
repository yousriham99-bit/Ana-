{%- style -%}
  #shopify-section-{{ section.id }} .anae-cta {
    --anae-accent: #D4537E; --anae-accent-2: #E8915B; --anae-ink: #3A2A22;
    --anae-cream: #FBF3E9; --anae-beige: #F0DCC4;
    background: linear-gradient(54deg, var(--anae-accent-2) 8%, var(--anae-accent) 92%);
    color: #fff;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .anae-cta__wrap { max-width: 820px; margin: 0 auto; padding: 0 20px; text-align: center; }
  #shopify-section-{{ section.id }} .anae-cta__eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: 1.25rem; font-weight: 700; opacity: .9; margin: 0 0 14px; }
  #shopify-section-{{ section.id }} .anae-cta__title { font-family: var(--font-heading-family, 'Fraunces', Georgia, serif); font-size: clamp(3rem, 5vw, 4.6rem); line-height: 1.08; margin: 0 0 16px; font-weight: 600; }
  #shopify-section-{{ section.id }} .anae-cta__text { font-size: 1.75rem; line-height: 1.55; opacity: .92; margin: 0 auto 28px; max-width: 50ch; }
  #shopify-section-{{ section.id }} .anae-cta__benefits { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 26px; margin: 0 0 30px; }
  #shopify-section-{{ section.id }} .anae-cta__benefit { display: inline-flex; align-items: center; gap: 8px; font-size: 1.45rem; font-weight: 600; }
  #shopify-section-{{ section.id }} .anae-cta__benefit svg { width: 20px; height: 20px; fill: #fff; }
  #shopify-section-{{ section.id }} .anae-cta__btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: #fff; color: var(--anae-accent); font-weight: 800; font-size: 1.8rem;
    padding: 20px 46px; border-radius: 100px; text-decoration: none;
    box-shadow: 0 16px 36px rgba(58,42,34,.25); transition: transform .15s ease, box-shadow .15s ease;
  }
  #shopify-section-{{ section.id }} .anae-cta__btn:hover { transform: translateY(-2px); box-shadow: 0 22px 46px rgba(58,42,34,.32); }
  #shopify-section-{{ section.id }} .anae-cta__btn svg { width: 22px; height: 22px; fill: var(--anae-accent); }
  #shopify-section-{{ section.id }} .anae-cta__reassure { margin: 18px 0 0; font-size: 1.35rem; opacity: .9; }
{%- endstyle -%}

<section class="anae-cta" aria-label="{{ section.settings.title | strip_html | escape }}">
  <div class="anae-cta__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="anae-cta__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="anae-cta__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="anae-cta__text">{{ section.settings.text }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="anae-cta__benefits">
        {%- for block in section.blocks -%}
          <span class="anae-cta__benefit" {{ block.shopify_attributes }}>{% render 'anae-icons', icon: block.settings.icon %}{{ block.settings.title }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <a class="anae-cta__btn" href="{{ section.settings.cta_url }}">{% render 'anae-icons', icon: 'bolt' %}{{ section.settings.cta_label }}</a>
    {%- if section.settings.reassurance != blank -%}<p class="anae-cta__reassure">{{ section.settings.reassurance }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Anaé · Dernier CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Prêt à changer de rituel ?" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ton énergie t'attend dans un stick" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une énergie stable, un geste de 10 secondes, une saveur qu'on adore. Rejoins celles et ceux qui ont remplacé le café qui les lâche.</p>" },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Commander maintenant" },
    { "type": "url", "id": "cta_url", "label": "Bouton — lien" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "default": "Satisfait ou remboursé 60 jours · Paiement sécurisé · Livraison rapide" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge haut", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge bas", "default": 80 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice rappelé",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "bolt",
          "options": [
            { "value": "bolt", "label": "Énergie" }, { "value": "timer", "label": "Rapidité" },
            { "value": "leaf", "label": "Naturel" }, { "value": "drop", "label": "Saveur" },
            { "value": "heart", "label": "Satisfaction" }, { "value": "shield", "label": "Garantie" }
          ] },
        { "type": "text", "id": "title", "label": "Texte", "default": "Énergie stable" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anaé · Dernier CTA",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "bolt", "title": "Énergie sans crash" } },
        { "type": "benefit", "settings": { "icon": "timer", "title": "Geste de 10 sec" } },
        { "type": "benefit", "settings": { "icon": "drop", "title": "Saveur fraise" } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Garantie 60 j" } }
      ]
    }
  ]
}
{% endschema %}
