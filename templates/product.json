    "anae_ingredients": {
      "type": "anae-ingredients",
      "settings": {
        "eyebrow": "La formule",
        "title": "Une formule courte. Des actifs qui comptent.",
        "intro": "<p>Pas de liste à rallonge : chaque ingrédient d'Anaé a une raison d'être. Voici ce qui compose ton stick.</p>",
        "padding_top": 64,
        "padding_bottom": 64
      },
      "blocks": {
        "b1": {
          "type": "ingredient",
          "settings": {
            "tag": "Actif clé",
            "name": "Berbérine",
            "text": "L'actif signature d'Anaé, extrait de plantes. Il structure la formule et soutient ton énergie de fond."
          }
        },
        "b2": {
          "type": "ingredient",
          "settings": {
            "tag": "Énergie",
            "name": "Yerba Maté",
            "text": "La plante des gauchos d'Amérique du Sud, riche en caféine naturelle, pour un boost franc sans la nervosité du café."
          }
        },
        "b3": {
          "type": "ingredient",
          "settings": {
            "tag": "Vitalité",
            "name": "Vitamines B",
            "text": "Un coup de pouce au métabolisme énergétique, pour transformer ce que tu manges en énergie utilisable."
          }
        },
        "b4": {
          "type": "ingredient",
          "settings": {
            "tag": "Plaisir",
            "name": "Arôme fraise naturel",
            "text": "Une saveur fraîche et gourmande qui donne envie de recommencer. Zéro arrière-goût poudreux."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ]
    },
